    "/api/v1/me/supplier": {
      "get": {
        "description": "Ficha del proveedor autenticado; `profile` es nulo hasta completarla (HU-SUP-01).\n\nLa escritura llega por sync (`supplier_profile`, P2), no por REST (PLAN_BACKEND §5).",
        "operationId": "my_supplier_api_v1_me_supplier_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MySupplierOut"
