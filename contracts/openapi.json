          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "My Supplier",
        "tags": [
          "suppliers"
        ]
      }
    },
    "/api/v1/sync/pull": {
      "get": {
        "description": "Cambios del proveedor posteriores a `last_pulled_at` (ms) y el nuevo `timestamp`.",
        "operationId": "pull_api_v1_sync_pull_get",
        "parameters": [
          {
            "in": "query",
            "name": "last_pulled_at",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Last Pulled At",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "schema_version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Schema Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
