# ==========================================================
# Variables de entorno — contrato docs/sistema/arquitectura.md §7.2
# Copiar a infra/.env (`make env`). NUNCA versionar infra/.env.
# Los valores de este archivo son solo para desarrollo local.
# ==========================================================

# ---------- Generales ----------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# RNF-I18N-001
TZ=America/Bogota

# ---------- PostgreSQL + TimescaleDB (servicio db) ----------
POSTGRES_USER=smile
POSTGRES_PASSWORD=smile
POSTGRES_DB=smile
# Conexión SQLAlchemy async usada por backend, worker y migrate
DATABASE_URL=postgresql+asyncpg://smile:smile@db:5432/smile

# ---------- Autenticación (S-13, RNF-SEC-003) ----------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-en-tu-env-local-no-usar-en-produccion
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# Orígenes permitidos, separados por comas
CORS_ORIGINS=http://localhost:3000

# ---------- Almacenamiento de objetos (ADR-0004) ----------
# s3 (SeaweedFS en dev; cualquier S3) | gcs (producción)
STORAGE_PROVIDER=s3
# Endpoint dentro de la red de compose
S3_ENDPOINT_URL=http://storage:8333
# Host con el que se firman las URLs que usa el navegador
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# En dev definen la identidad S3 que SeaweedFS acepta
S3_ACCESS_KEY=smile
S3_SECRET_KEY=smile-secret
S3_BUCKET=smile-files
S3_REGION=us-east-1

# ---------- Datos de demostración (MODO_POC §3) ----------
# true: el servicio seed carga usuarios y datos de demo (idempotente)
SEED_DEMO=true

# ---------- Correo (mailpit en perfil dev) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025

# ---------- Frontend ----------
# URL de la API vista por el navegador (se inyecta también en build)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL de la API dentro de la red de compose (SSR)
API_INTERNAL_URL=http://backend:8000

# ---------- Puertos publicados en el host (opcionales) ----------
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
STORAGE_S3_PORT=9000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
BACKEND_DEBUG_PORT=5678
FRONTEND_DEBUG_PORT=9229
